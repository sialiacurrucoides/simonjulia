---
import DatabaseIcon from "../assets/icons/DatabaseIcon.astro";
import AstroIcon from "../assets/icons/AstroIcon.astro";
import AccessibilityIcon from "../assets/icons/Accessibility.astro";
import SecretsManager from "../assets/icons/SecretsManager.astro";
import DiagramIcon from "../assets/icons/DiagramIcon.astro";
import GitIcon from "../assets/icons/GitIcon.astro";
import DrizzleIcon from "../assets/icons/DrizzleIcon.astro";
import Turborepo from "../assets/icons/Turborepo.astro";
import ReactIcon from "../assets/icons/ReactIcon.astro";
import TanStackIcon from "../assets/icons/TanStackIcon.astro";
import ZustandIcon from "../assets/icons/ZustandIcon.astro";
import PlaywrightIcon from "../assets/icons/PlaywrightIcon.astro";
import ObservabilityIcon from "../assets/icons/ObservabilityIcon.astro";
import OTPAuthIcon from "../assets/icons/OTPAuthIcon.astro";
import ShieldIcon from "../assets/icons/ShieldIcon.astro";
import OfflineIcon from "../assets/icons/OfflineIcon.astro";

const { title, date, slug, lang } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' });

const iconList = new Map([
    ["database-fundamentals", DatabaseIcon],
    ["astro", AstroIcon],
    ["accessibility", AccessibilityIcon],
    ["secrets-management", SecretsManager],
    ["database-diagrams", DiagramIcon],
    ["git-hooks", GitIcon],
    ["drizzle", DrizzleIcon],
    ["turborepo", Turborepo],
    ["react-compiler", ReactIcon],
    ["tanstack-router-with-query", TanStackIcon],
    ["zustand", ZustandIcon],
    ["playwright", PlaywrightIcon],
    ["observability", ObservabilityIcon],
    ["mfa", OTPAuthIcon],
    ["csp", ShieldIcon],
    ["offline-support", OfflineIcon]
    // Add more mappings as needed
]);

const Icon = iconList.get(slug);
---

<li><a class="post-link" href={`/${lang}/blog/${slug}`}>
   <div class="title-section">
    <div class="icon-container">
        {Icon && <Icon />}
    </div>
    {title}
    </div>
   <div>{formattedDate}</div>
</a></li>

<style>
    li {
        margin-bottom: 0.5rem;
    }

    .icon-container {
        display: inline-flex;
        align-items: center;
        margin-right: 0.5rem;
        width: 24px;
        height: 24px;
    }

    .icon-container svg {
        width: 100%;
        height: 100%;
    }

    .title-section {
        display: inline-flex;
        align-items: center;
    }

    .icon-image {
        display: flex;
        justify-items: center;
        fill: var(--main-bg-color);
    }

     .post-link {
        background-color: var(--light-bg);
        padding: 0.5rem 1rem;
        text-decoration: none;
        color: var(--main-bg-color);
        font-weight: bold;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        border: 2px solid var(--main-bg-color);
        border-radius: 8px;
    }

    .post-link:hover {
        background-color: var(--main-bg-color-light);
        color: var(--soft-white);
        border-color: var(--main-bg-color-light);
    }

    @media screen and (max-width: 600px) {
        .post-link {
            flex-direction: column;
            align-items: flex-start;
        }
    }

</style>